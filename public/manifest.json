{
  "manifest_version": 3,
  "name": "Lumos",
  "version": "1.0.0",
  "permissions": ["storage", "activeTab", "tabs"],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "modal/modal.js",
        "detector/overlay.js",
        "detector/scanner.js"
      ],
      "css": [
        "common.css",
        "modal/modal.css",
        "detector/detector.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.svg",
        "main-logo.svg",
        "vite.svg",
        "policy/*",
        "data/policy.json"
      ],
      "matches": ["<all_urls>"]
    }
  ], 
  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  }
}
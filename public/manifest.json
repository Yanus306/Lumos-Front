{
  "manifest_version": 3,
  "name": "Lumos",
  "version": "1.0.0",
  "permissions": ["storage", "activeTab", "tabs"],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["modal/modal.js"],
      "css": ["common.css", "modal/modal.css"], 
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*.svg", "main-logo.svg", "vite.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}